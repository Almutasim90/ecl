# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# PostgreSQL connection string (Npgsql format)
# Example: Host=db.example.com;Port=5432;Database=ecl;Username=ecl_user;Password=secret
DATABASE_URL=Host=localhost;Port=5432;Database=ecl;Username=postgres;Password=changeme

# JWT secret from your Supabase GoTrue dashboard (Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# The public URL of the web app — used for CORS allow-list
WEB_ORIGIN=https://ecl.almutasim.site

# Supabase anon key (used by Flutter mobile app)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ASP.NET Core environment (Production | Development)
ASPNETCORE_ENVIRONMENT=Production
