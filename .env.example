# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# See docs/DATABASE_CONNECTION.md for full connection requirements.

# ── Required: PostgreSQL ────────────────────────────────────────────────────
# Docker/Coolify: set DATABASE_URL or ConnectionStrings__DefaultConnection here or in the Coolify UI.
# Inside a container, Host=localhost is WRONG unless Postgres runs in the same container.
# If Postgres is on the VPS host: Host=host.docker.internal (see docker-compose extra_hosts).
# URI form (SSL query supported by the app):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@your-db-host:5432/ecl?sslmode=require
# Npgsql form:
# DATABASE_URL=Host=your-db-host;Port=5432;Database=ecl;Username=postgres;Password=YOUR_PASSWORD
DATABASE_URL=
ConnectionStrings__DefaultConnection=

# The public URL of the web app — used for CORS allow-list
WEB_ORIGIN=https://ecl.almutasim.site

# ASP.NET Core environment (Production | Development)
ASPNETCORE_ENVIRONMENT=Production

# Admin login for managing questions (DO NOT commit real secrets)
AdminCredentials__Username=admin
AdminCredentials__Password=change-me
