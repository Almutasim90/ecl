# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# See docs/DATABASE_CONNECTION.md for full connection requirements.

# ── Required: PostgreSQL (Supabase DB) ───────────────────────────────────────
# App uses DATABASE_URL if set; else ConnectionStrings:DefaultConnection.
# Recommended for local dev: use SSH tunnel (see docs/SUPABASE_PUBLIC_ACCESS.md):
#   ssh -L 5432:supabase-db:5432 root@YOUR_VPS_IP
#   Then: Host=localhost (no public DB exposure).
# For direct/public: Host=supabase.almutasim.site (only if you hardened per doc).
DATABASE_URL=Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD

# The public URL of the web app — used for CORS allow-list
WEB_ORIGIN=https://ecl.almutasim.site

# ASP.NET Core environment (Production | Development)
ASPNETCORE_ENVIRONMENT=Production

# Admin login for managing questions (DO NOT commit real secrets)
AdminCredentials__Username=admin
AdminCredentials__Password=change-me
