@model ECL.Models.AdminResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="section-header">
    <div class="section-header-text">
        <h1 class="section-title">Reset password</h1>
        <p class="section-subtitle">Student: <strong>@Model.Username</strong></p>
    </div>
    <a asp-action="Index" class="btn btn-ghost">
        <i class="bi bi-arrow-left"></i> Back to list
    </a>
</div>

<div class="auth-wrap" style="padding-top:0;">
    <div class="auth-card" style="max-width:440px;">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-error">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="ResetPassword" method="post" autocomplete="off" class="auth-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Username" />

            <div class="field-group">
                <label asp-for="NewPassword" class="field-label"></label>
                <input asp-for="NewPassword" class="field-input auth-input" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>

            <div class="field-group">
                <label asp-for="ConfirmPassword" class="field-label"></label>
                <input asp-for="ConfirmPassword" class="field-input auth-input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-primary auth-submit">
                <i class="bi bi-key-fill"></i>
                <span>Save new password</span>
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
