@model IReadOnlyList<ECL.Models.AdminStudentUserRowViewModel>
@{
    ViewData["Title"] = "Student accounts";
}

<div class="section-header">
    <div class="section-header-text">
        <h1 class="section-title">Student accounts</h1>
        <p class="section-subtitle">
            Create student logins, reset passwords, or remove accounts.
            The configuration-based admin user is not listed here.
        </p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus"></i> Add student
    </a>
</div>

@if (TempData["UserMgmtMessage"] is string flash && !string.IsNullOrWhiteSpace(flash))
{
    <div class="alert-info" role="status" style="margin-bottom:16px;">
        <i class="bi bi-check-circle-fill"></i> @flash
    </div>
}

<div class="table-card">
    @if (Model.Count == 0)
    {
        <p class="muted-note" style="padding:20px;">No student accounts yet.</p>
    }
    else
    {
        <table class="display stripe hover w-full" style="width:100%">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Registered (UTC)</th>
                    <th>Quiz attempts</th>
                    <th style="width:220px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td><strong>@u.Username</strong></td>
                        <td>@u.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@u.QuizAttemptsCount</td>
                        <td>
                            <div class="flex items-center flex-wrap" style="gap:8px;">
                                <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn btn-ghost">
                                    <i class="bi bi-key"></i> Reset password
                                </a>
                                <form asp-action="Delete" asp-route-id="@u.Id" method="post" style="display:inline;"
                                      onsubmit="return confirm('Delete this student account? Their quiz history will be removed.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
