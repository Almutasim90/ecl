@{
    ViewData["Title"] = "Reading Questions";
}

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Reading Questions</h1>
    <a asp-action="Create"
       class="inline-flex items-center gap-1 px-4 py-2 bg-blue-600 text-white font-medium rounded-lg shadow hover:bg-blue-700 transition text-sm">
        <span class="material-icons text-sm">add</span> Create New
    </a>
</div>

<div class="overflow-x-auto rounded-lg shadow">
    <table id="ReadingTable" class="display material hover stripe w-full">
        <thead>
            <tr>
                <th>Q#</th>
                <th>Form</th>
                <th>Question</th>
                <th>Option A</th>
                <th>Option B</th>
                <th>Option C</th>
                <th>Option D</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

@section Scripts {
    <script>
    $(function () {
        $('#ReadingTable').DataTable({
            serverSide:  true,
            processing:  true,
            responsive:  true,
            pageLength:  10,
            ajax: {
                url:  '@Url.Action("LoadData", "ReadingQuestions")',
                type: 'GET',
                data: function (d) {
                    return {
                        draw:        d.draw,
                        start:       d.start,
                        length:      d.length,
                        search:      d.search.value,
                        orderColumn: d.columns[d.order[0].column].data,
                        orderDir:    d.order[0].dir
                    };
                },
                error: function (xhr, error, thrown) {
                    console.error('DataTable AJAX error', xhr.status, thrown);
                }
            },
            columns: [
                { data: 'qno',          title: 'Q#',       width: '55px'  },
                { data: 'formNumber',   title: 'Form',     width: '65px'  },
                { data: 'questionText', title: 'Question'                  },
                { data: 'optionA',      title: 'Option A'                  },
                { data: 'optionB',      title: 'Option B'                  },
                { data: 'optionC',      title: 'Option C'                  },
                { data: 'optionD',      title: 'Option D'                  },
                {
                    data:       'qno',
                    title:      'Actions',
                    orderable:  false,
                    searchable: false,
                    width:      '160px',
                    render: function (id) {
                        return '<a class="btn btn-sm btn-outline-primary me-1"   href="/ReadingQuestions/Details/' + id + '" title="View"><span class="material-icons" style="font-size:16px">visibility</span></a>' +
                               '<a class="btn btn-sm btn-outline-secondary me-1" href="/ReadingQuestions/Edit/'    + id + '" title="Edit"><span class="material-icons" style="font-size:16px">edit</span></a>' +
                               '<a class="btn btn-sm btn-outline-danger"          href="/ReadingQuestions/Delete/'  + id + '" title="Delete"><span class="material-icons" style="font-size:16px">delete</span></a>';
                    }
                }
            ],
            order:      [[0, 'asc']],
            lengthMenu: [[10, 25, 50, 100, -1], ['10', '25', '50', '100', 'All']],
            language: {
                processing: '<span class="material-icons spin">autorenew</span> Loading…',
                paginate: {
                    previous: '<span class="material-icons">chevron_left</span>',
                    next:     '<span class="material-icons">chevron_right</span>'
                },
                info:    'Showing _START_–_END_ of _TOTAL_ questions',
                search:  '<span class="material-icons align-middle" style="font-size:18px">search</span>'
            }
        });
    });
    </script>
}
