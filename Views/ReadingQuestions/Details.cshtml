@model ECL.Models.ReadingQuestion

@{
    ViewData["Title"] = "Reading Question Details";
}

<div class="max-w-lg">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">Reading Question Details</h1>

    <div class="bg-white rounded-xl shadow p-6 space-y-3">
        <div class="grid grid-cols-3 gap-2 border-b border-gray-100 pb-2">
            <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(m => m.FormNumber)</dt>
            <dd class="col-span-2 text-sm text-gray-900">@Html.DisplayFor(m => m.FormNumber)</dd>
        </div>
        <div class="grid grid-cols-3 gap-2 border-b border-gray-100 pb-2">
            <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(m => m.QuestionText)</dt>
            <dd class="col-span-2 text-sm text-gray-900">@Html.DisplayFor(m => m.QuestionText)</dd>
        </div>
        <div class="grid grid-cols-3 gap-2 border-b border-gray-100 pb-2">
            <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(m => m.OptionA)</dt>
            <dd class="col-span-2 text-sm text-gray-900">@Html.DisplayFor(m => m.OptionA)</dd>
        </div>
        <div class="grid grid-cols-3 gap-2 border-b border-gray-100 pb-2">
            <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(m => m.OptionB)</dt>
            <dd class="col-span-2 text-sm text-gray-900">@Html.DisplayFor(m => m.OptionB)</dd>
        </div>
        <div class="grid grid-cols-3 gap-2 border-b border-gray-100 pb-2">
            <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(m => m.OptionC)</dt>
            <dd class="col-span-2 text-sm text-gray-900">@Html.DisplayFor(m => m.OptionC)</dd>
        </div>
        <div class="grid grid-cols-3 gap-2 border-b border-gray-100 pb-2">
            <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(m => m.OptionD)</dt>
            <dd class="col-span-2 text-sm text-gray-900">@Html.DisplayFor(m => m.OptionD)</dd>
        </div>
        <div class="grid grid-cols-3 gap-2">
            <dt class="text-sm font-medium text-gray-500">@Html.DisplayNameFor(m => m.CorrectOption)</dt>
            <dd class="col-span-2 text-sm text-gray-900">@Html.DisplayFor(m => m.CorrectOption)</dd>
        </div>
    </div>

    <div class="flex gap-4 mt-4">
        <a asp-action="Edit" asp-route-id="@Model?.Qno"
           class="px-4 py-2 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700 transition">Edit</a>
        <a asp-action="Index" class="text-gray-500 hover:text-gray-700 text-sm self-center">Back to List</a>
    </div>
</div>
