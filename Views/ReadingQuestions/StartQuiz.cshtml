@model List<int>
@{
    ViewData["Title"] = "Start Reading Quiz";
}

@if (TempData["DbError"] != null)
{
    <div class="alert-error mb-5">
        <strong>Database Error:</strong> @TempData["DbError"]
        <br/><small>Check that the database is connected and contains data.</small>
    </div>
}

@if (!Model.Any())
{
    <div class="alert-warning">
        No quiz forms available. The database may be empty or unreachable.
    </div>
}
else
{
    <p class="text-sm text-gray-400 mb-5">Choose a form to begin your reading practice session.</p>

    <div class="quiz-form-grid grid sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        @foreach (var num in Model)
        {
            <a asp-action="Quiz" asp-route-formNumber="@num" class="quiz-form-card no-underline">
                <div class="form-number" style="background:#f0fdf4;color:#16a34a">@num</div>
                <div class="text-sm font-semibold text-gray-700">Form @num</div>
                <div class="text-xs text-green-600 font-medium mt-1">
                    <i class="bi bi-play-fill"></i> Start
                </div>
            </a>
        }
    </div>
}
