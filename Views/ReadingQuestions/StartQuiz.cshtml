@model List<int>
@{
    ViewData["Title"] = "Reading Quiz";
}

@if (TempData["DbError"] != null)
{
    <div class="alert-error">
        <strong>Database Error:</strong> @TempData["DbError"]
        <br /><small>Check that the database is connected and contains data.</small>
    </div>
}

@if (!Model.Any())
{
    <div class="alert-warning">
        <i class="bi bi-exclamation-triangle"></i>
        No quiz forms available. The database may be empty or unreachable.
    </div>
}
else
{
    <p class="muted-note">
        Choose a form to begin your reading practice session.
    </p>

    <div class="reading-toolbar">
        <div class="toolbar-search">
            <span class="material-icons">search</span>
            <input type="text" id="readingSearch" placeholder="Search forms..." class="toolbar-search-input"
                   aria-label="Search reading forms">
        </div>
    </div>

    <div class="form-grid" id="readingFormGrid">
        @foreach (var num in Model)
        {
            <a asp-action="Quiz" asp-route-formNumber="@num" class="form-grid-card green">
                <div class="form-num green">@num</div>
                <div class="form-grid-card-label">Form @num</div>
                <div class="form-grid-card-cta">
                    <i class="bi bi-play-fill"></i> Start
                </div>
            </a>
        }
    </div>

    <div class="form-grid-empty" id="readingEmpty" hidden>
        <i class="bi bi-search"></i>
        <span>No forms match your search.</span>
    </div>

    <script>
    (function () {
        var search = document.getElementById('readingSearch');
        var grid   = document.getElementById('readingFormGrid');
        var empty  = document.getElementById('readingEmpty');
        if (!search || !grid) return;

        var cards = grid.querySelectorAll('.form-grid-card');

        search.addEventListener('input', function () {
            var term  = this.value.trim().toLowerCase();
            var shown = 0;
            cards.forEach(function (card) {
                var label = (card.querySelector('.form-grid-card-label')?.textContent || '').toLowerCase();
                var match = !term || label.indexOf(term) !== -1;
                card.style.display = match ? '' : 'none';
                if (match) shown++;
            });
            if (empty) empty.hidden = shown !== 0;
        });
    })();
    </script>
}
