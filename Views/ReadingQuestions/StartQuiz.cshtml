@model List<int>
@{
    ViewData["Title"] = "Start Reading Quiz";
}

<h1 class="text-2xl font-bold text-gray-800 mb-6 text-center">Start Reading Quiz</h1>

@if (TempData["DbError"] != null)
{
    <div class="bg-red-100 border border-red-400 text-red-800 px-4 py-3 rounded mb-4">
        <strong>⚠️ Database Error:</strong> @TempData["DbError"]
        <br/><small>Check that the database is connected and contains data.</small>
    </div>
}

@if (!Model.Any())
{
    <div class="bg-yellow-100 border border-yellow-400 text-yellow-800 px-4 py-3 rounded mb-4 text-center">
        No quiz forms available. The database may be empty or unreachable.
    </div>
}

<div class="quiz-form-grid grid sm:grid-cols-2 md:grid-cols-3 gap-4">
    @foreach (var num in Model)
    {
        <div class="bg-white rounded-xl shadow-md p-6 flex flex-col items-center justify-center hover:shadow-lg transition">
            <h2 class="text-xl font-bold text-gray-700 mb-3">Form @num</h2>
            <a asp-action="Quiz" asp-route-formNumber="@num"
               class="px-5 py-2 bg-green-600 text-white font-medium rounded-lg hover:bg-green-700 transition">
                Start Form @num
            </a>
        </div>
    }
</div>
