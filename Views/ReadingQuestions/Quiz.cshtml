@model List<ECL.Models.ReadingQuestion>
@using System.Text.Json;
@{
    ViewData["Title"] = "Reading Quiz Form " + ViewBag.FormNumber;
}
<div class="container my-5">
    <div class="card mx-auto shadow-lg border-0 rounded-4 overflow-hidden" style="max-width: 600px;">
        <div class="card-header text-center bg-gradient bg-success text-white py-3">
            <h4 class="mb-1 fw-bold">Reading Quiz: Form @ViewBag.FormNumber</h4>
            <small id="progress" class="text-light fst-italic">Question 1 of @Model.Count</small>
        </div>
        <div class="card-body bg-light">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div id="stats-summary" class="text-start fw-semibold"></div>
                <div class="gauge-container" style="width:80px; height:80px;">
                    <svg viewBox="0 0 100 100">
                        <circle class="gauge-bg" cx="50" cy="50" r="45" />
                        <circle class="gauge-fg" cx="50" cy="50" r="45" />
                        <text id="gauge-text" x="50" y="55" text-anchor="middle" font-size="18" fill="#333"></text>
                    </svg>
                </div>
            </div>
            <div id="question-text" class="mb-4 fs-5 fw-medium"></div>
            <form id="quizForm">
                <div id="optionsContainer" class="list-group mb-3"></div>
                <button type="button" id="submitBtn" class="btn btn-success w-100 fw-semibold py-2" disabled>
                    Submit Answer
                </button>
                <div class="d-flex gap-2 mt-2">
                    <button type="button" id="prevBtn" class="btn btn-outline-secondary flex-fill" disabled>Previous</button>
                    <button type="button" id="skipBtn" class="btn btn-outline-secondary flex-fill">Skip</button>
                </div>
            </form>
            <div id="feedback" class="mt-3 text-center fw-bold fs-5"></div>
        </div>
    </div>
</div>
<style>
    .gauge-bg { fill:none; stroke:#e9ecef; stroke-width:10; }
    .gauge-fg { fill:none; stroke:#37a04f; stroke-width:10; stroke-linecap:round; transform:rotate(-90deg); transform-origin:50px 50px; stroke-dasharray:283; stroke-dashoffset:283; }
    .list-group-item:hover { background-color:#f0f8ff; cursor:pointer; }
    #feedback.correct { color:#28a745; }
    #feedback.wrong { color:#dc3545; }
</style>
@section Scripts {
<script>
    const questions = @Html.Raw(JsonSerializer.Serialize(Model));
    let current = 0;
    const total = questions.length;
    const storageKey = 'readingQuizState_' + '@ViewBag.FormNumber';
    let answers = Array(total).fill(null); // { choice, submitted, correct }

    // restore state if present
    const saved = localStorage.getItem(storageKey);
    if (saved) {
        try {
            const s = JSON.parse(saved);
            if (typeof s.current === 'number' && Array.isArray(s.answers)) {
                current = Math.min(s.current, total - 1);
                answers = s.answers.concat(Array(total - s.answers.length).fill(null)).slice(0, total);
            }
        } catch (e) { console.warn('Invalid saved quiz state', e); }
    }
    const gaugeFg = document.querySelector('.gauge-fg');
    const gaugeText = document.getElementById('gauge-text');
    const gaugeRadius = 45;
    const gaugeCircumference = 2 * Math.PI * gaugeRadius;
    const statsSummaryEl = document.getElementById('stats-summary');
    const progressEl = document.getElementById('progress');
    const questionTextEl = document.getElementById('question-text');
    const optsContainer = document.getElementById('optionsContainer');
    const submitBtn = document.getElementById('submitBtn');
    const feedbackEl = document.getElementById('feedback');
    const prevBtn = document.getElementById('prevBtn');
    const skipBtn = document.getElementById('skipBtn');

    function updateScoreSummary() {
        const score = answers.reduce((acc, a) => acc + (a && a.submitted && a.correct ? 1 : 0), 0);
        const asked = answers.reduce((acc, a) => acc + (a && a.submitted ? 1 : 0), 0);
        const pct = total ? Math.round((score / total) * 100) : 0;
        const offset = gaugeCircumference * (1 - score / total);
        gaugeFg.style.strokeDashoffset = offset;
        gaugeText.textContent = `${pct}%`;
        statsSummaryEl.innerHTML = `Answered: ${asked} / ${total}<br/>Correct: ${score}<br/>Incorrect: ${asked - score}`;
    }

    function loadQuestion() {
        feedbackEl.innerHTML = '';
        submitBtn.textContent = 'Submit';
        submitBtn.disabled = true;
        optsContainer.innerHTML = '';
        updateScoreSummary();
        const q = questions[current];
        progressEl.textContent = `Question ${current+1} of ${total}`;
        questionTextEl.textContent = q.QuestionText;
        prevBtn.disabled = current === 0;
        saveState();

        // if we have an answers entry for this question, pre-populate
        const savedAns = answers[current];
        ['OptionA','OptionB','OptionC','OptionD'].forEach((optKey, idx) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'list-group-item list-group-item-action mb-2';
            btn.textContent = q[optKey];
            btn.dataset.value = idx+1;
            btn.addEventListener('click', () => selectOption(btn));
            optsContainer.appendChild(btn);
        });

        if (savedAns) {
            // restore selection if any
            if (savedAns.choice) {
                const btn = optsContainer.children[savedAns.choice - 1];
                if (btn) btn.classList.add('active');
                if (!savedAns.submitted) submitBtn.disabled = false;
            }
            if (savedAns.submitted) {
                // show feedback and mark correctness
                const choice = savedAns.choice;
                if (choice) {
                    const sel = optsContainer.children[choice - 1];
                    if (sel) {
                        if (savedAns.correct) sel.classList.replace('active','list-group-item-success');
                        else sel.classList.replace('active','list-group-item-danger');
                    }
                }
                if (!savedAns.correct) {
                    const correctBtn = optsContainer.children[questions[current].CorrectOption - 1];
                    if (correctBtn) correctBtn.classList.add('list-group-item-success');
                }
                feedbackEl.innerHTML = savedAns.submitted && savedAns.correct ? '<span class="text-success">Correct!</span>' : `<span class="text-danger">Wrong! Correct answer: ${optsContainer.children[questions[current].CorrectOption-1].textContent}</span>`;
                submitBtn.textContent = current+1 < total ? 'Next' : 'Finish';
                submitBtn.removeEventListener('click', submitHandler);
                submitBtn.addEventListener('click', nextHandler);
            }
        }
    }

    function selectOption(btn) {
        Array.from(optsContainer.children).forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        submitBtn.disabled = false;
        // save tentative choice (not submitted yet)
        const choice = parseInt(btn.dataset.value);
        answers[current] = answers[current] || { choice: null, submitted: false, correct: null };
        answers[current].choice = choice;
        saveState();
    }

    submitBtn.addEventListener('click', () => {
        const selectedBtn = optsContainer.querySelector('.active');
        const choice = parseInt(selectedBtn.dataset.value);
        const correct = questions[current].CorrectOption;
        if (choice === correct) {
            selectedBtn.classList.replace('active', 'list-group-item-success');
            feedbackEl.innerHTML = '<span class="text-success">Correct!</span>';
            // record
            answers[current] = answers[current] || { choice: null, submitted: false, correct: null };
            if (!answers[current].submitted) answers[current].submitted = true;
            answers[current].correct = true;
        } else {
            selectedBtn.classList.replace('active','list-group-item-danger');
            const correctBtn = optsContainer.children[correct-1];
            correctBtn.classList.add('list-group-item-success');
            feedbackEl.innerHTML = `<span class="text-danger">Wrong! Correct answer: ${correctBtn.textContent}</span>`;
            answers[current] = answers[current] || { choice: null, submitted: false, correct: null };
            if (!answers[current].submitted) answers[current].submitted = true;
            answers[current].correct = false;
        }
        updateScoreSummary();
        saveState();
        submitBtn.textContent = current+1 < total ? 'Next' : 'Finish';
        submitBtn.disabled = false;
        submitBtn.removeEventListener('click', submitHandler);
        submitBtn.addEventListener('click', nextHandler);
    });

    function submitHandler() {}

    function nextHandler() {
        current++;
        if (current < total) {
            submitBtn.removeEventListener('click', nextHandler);
            submitBtn.addEventListener('click', submitHandler);
            loadQuestion();
        } else {
            const pct = total ? Math.round((score / total) * 100) : 0;
            if (confirm(`Thank you for completing the quiz!\nYour score: ${pct}%\nReturn to start?`)) {
                window.location.href = '@Url.Action("StartQuiz")';
            }
        }
    }

    // Previous and Skip handlers
    prevBtn.addEventListener('click', () => {
        if (current > 0) {
            current--;
            saveState();
            loadQuestion();
        }
    });

    skipBtn.addEventListener('click', () => {
        // mark as not submitted but keep any tentative choice
        answers[current] = answers[current] || { choice: null, submitted: false, correct: null };
        // advance
        if (current < total - 1) {
            current++;
            saveState();
            loadQuestion();
        }
    });

    function saveState() {
        try {
            const payload = { current: current, answers: answers };
            localStorage.setItem(storageKey, JSON.stringify(payload));
        } catch (e) { console.warn('Could not save quiz state', e); }
    }

    loadQuestion();
    submitBtn.addEventListener('click', submitHandler);
</script>
}
