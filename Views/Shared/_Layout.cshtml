<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ECL</title>
    <script>
        (function () {
            const key = 'ecl.theme';
            let theme = null;
            try { theme = localStorage.getItem(key); } catch (_) { }
            if (theme !== 'light' && theme !== 'dark') {
                theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <link rel="stylesheet" href="https://cdn.datatables.net/v/dt/dt-1.13.6/r-2.5.0/datatables.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body>
    <!-- Mobile hamburger -->
    <button id="drawer-toggle" aria-label="Toggle menu" aria-expanded="false">
        <i class="bi bi-list"></i>
    </button>

    <!-- Mobile overlay backdrop -->
    <div id="sidebar-backdrop" class="sidebar-backdrop"></div>

    <div class="shell">

        <!-- ── Sidebar ── -->
        <aside id="sidebar" class="sidebar" role="navigation" aria-label="Primary navigation">

            <div class="sidebar-logo">
                <a asp-controller="Home" asp-action="Index" class="sidebar-logo-link">
                    <span class="sidebar-logo-icon">
                        <i class="bi bi-soundwave"></i>
                    </span>
                    <span class="sidebar-logo-text">ECL</span>
                </a>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-group">
                    <span class="nav-group-label">Overview</span>
                    <a class="slink" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-grid-1x2"></i>
                        <span>Dashboard</span>
                    </a>
                </div>

                @if (User?.IsInRole("Admin") == true)
                {
                    <div class="nav-group">
                        <span class="nav-group-label">Manage</span>
                        <a class="slink" asp-controller="ListeningQuestions" asp-action="Index">
                            <i class="bi bi-headphones"></i>
                            <span>Listening Questions</span>
                        </a>
                        <a class="slink" asp-controller="ReadingQuestions" asp-action="Index">
                            <i class="bi bi-journal-text"></i>
                            <span>Reading Questions</span>
                        </a>
                        <a class="slink" asp-controller="GrammarQuestions" asp-action="Index">
                            <i class="bi bi-spellcheck"></i>
                            <span>Grammar Questions</span>
                        </a>
                    </div>
                }

                <div class="nav-group">
                    <span class="nav-group-label">Practice</span>
                    <a class="slink" asp-controller="ListeningQuestions" asp-action="StartQuiz">
                        <i class="bi bi-headphones-simple"></i>
                        <span>Listening Quiz</span>
                    </a>
                    <a class="slink" asp-controller="ReadingQuestions" asp-action="StartQuiz">
                        <i class="bi bi-book-open"></i>
                        <span>Reading Quiz</span>
                    </a>
                    <a class="slink" asp-controller="GrammarQuestions" asp-action="StartQuiz">
                        <i class="bi bi-spellcheck"></i>
                        <span>Grammar Quiz</span>
                    </a>
                </div>
            </nav>

            <div class="sidebar-footer">
                <a asp-controller="Home" asp-action="Privacy" class="sidebar-footer-link">
                    <i class="bi bi-shield-check"></i> Privacy
                </a>
            </div>

        </aside>

        <!-- ── Main area ── -->
        <div class="main-area">

            <!-- Topbar -->
            <header class="topbar">
                <div class="topbar-left">
                    <button id="sidebar-desktop-toggle" class="sidebar-desktop-toggle" aria-label="Toggle sidebar">
                        <i class="bi bi-layout-sidebar"></i>
                    </button>
                    <div class="topbar-page-title">@ViewData["Title"]</div>
                </div>
                <div class="topbar-right">
                    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark mode" title="Toggle theme">
                        <i id="theme-toggle-icon" class="bi bi-moon-stars"></i>
                        <span id="theme-toggle-label">Dark</span>
                    </button>
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <span class="topbar-badge">
                            <i class="bi bi-person-check"></i> @User.Identity!.Name
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="theme-toggle" title="Logout" aria-label="Logout">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Logout</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="theme-toggle" asp-controller="Account" asp-action="Login" title="Login" aria-label="Login">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Login</span>
                        </a>
                    }
                </div>
            </header>

            <!-- Page content -->
            <main class="page-content" role="main">
                @RenderBody()
            </main>

            <footer class="page-footer">
                &copy; 2025 ECL — English Comprehension Learning
            </footer>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.datatables.net/v/dt/dt-1.13.6/r-2.5.0/datatables.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script type="module" src="~/js/drawer.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
