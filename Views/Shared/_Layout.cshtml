<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ECL</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <link rel="stylesheet" href="https://cdn.datatables.net/v/dt/dt-1.13.6/r-2.5.0/datatables.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body class="bg-gray-50 text-gray-900">
    <button id="drawer-toggle" aria-label="Toggle navigation" aria-controls="sidebar" aria-expanded="false">
        <i class="bi bi-list text-xl" aria-hidden="true"></i>
    </button>

    <div class="content-wrapper">
        <nav id="sidebar" class="sidebar" role="navigation" aria-label="Primary">
            <a class="sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-icon"><i class="bi bi-soundwave"></i></span>
                ECL
            </a>

            <div class="sidebar-section">Main</div>
            <ul>
                <li>
                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door"></i>Home
                    </a>
                </li>
            </ul>

            <div class="sidebar-section">Manage</div>
            <ul>
                <li>
                    <a class="nav-link" asp-area="" asp-controller="ListeningQuestions" asp-action="Index">
                        <i class="bi bi-headphones"></i>Listening Questions
                    </a>
                </li>
                <li>
                    <a class="nav-link" asp-area="" asp-controller="ReadingQuestions" asp-action="Index">
                        <i class="bi bi-journal-text"></i>Reading Questions
                    </a>
                </li>
            </ul>

            <div class="sidebar-section">Practice</div>
            <ul>
                <li>
                    <a class="nav-link" asp-area="" asp-controller="ListeningQuestions" asp-action="StartQuiz">
                        <i class="bi bi-ear"></i>Listening Quiz
                    </a>
                </li>
                <li>
                    <a class="nav-link" asp-area="" asp-controller="ReadingQuestions" asp-action="StartQuiz">
                        <i class="bi bi-book-open"></i>Reading Quiz
                    </a>
                </li>
            </ul>
        </nav>

        <div id="main-content" class="main-content">
            <div class="topbar">
                <div>
                    <div class="topbar-title">@ViewData["Title"]</div>
                    <div class="topbar-subtitle">English Comprehension Learning</div>
                </div>
            </div>

            <div class="page-body">
                <main role="main">
                    @RenderBody()
                </main>

                <footer class="border-t border-gray-200 mt-10 py-4 text-center text-sm text-gray-400">
                    &copy; 2025 ECL &mdash; <a asp-area="" asp-controller="Home" asp-action="Privacy" class="hover:text-gray-600 hover:underline">Privacy</a>
                </footer>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.datatables.net/v/dt/dt-1.13.6/r-2.5.0/datatables.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script type="module" src="~/js/drawer.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
