@model ECL.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-mark" aria-hidden="true">
                <i class="bi bi-person-plus-fill"></i>
            </div>
            <div>
                <div class="auth-title">Create student account</div>
                <div class="auth-subtitle">Save history, track progress, and resume later.</div>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-error">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="Register" method="post" autocomplete="off" class="auth-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="field-group">
                <label asp-for="Username" class="field-label"></label>
                <input asp-for="Username" class="field-input auth-input" inputmode="text" autocomplete="username" />
                <span asp-validation-for="Username" class="field-error"></span>
            </div>

            <div class="field-group">
                <label asp-for="Password" class="field-label"></label>
                <input asp-for="Password" class="field-input auth-input" autocomplete="new-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="field-group">
                <label asp-for="ConfirmPassword" class="field-label"></label>
                <input asp-for="ConfirmPassword" class="field-input auth-input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-primary auth-submit">
                <i class="bi bi-check2-circle"></i>
                <span>Create account</span>
            </button>

            <div class="muted-note" style="margin:10px 0 0;">
                Already have an account?
                <a asp-controller="Account" asp-action="Login" style="font-weight:700;">Sign in</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

