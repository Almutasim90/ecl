@model ECL.Models.DashboardViewModel
@{
    ViewData["Title"] = "Home";
    var totalForms = Model.TotalListeningReadingFormsCount;
    var totalTopics = Model.GrammarTopicsCount;
}

@if (ViewData["DashboardWarning"] is string msg)
{
    <div class="alert-warning" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @msg
        <a asp-controller="Home" asp-action="DatabaseUnavailable">Details</a>
    </div>
}

<div class="dash-page">
    <section aria-label="Home overview">
        <div class="section-header">
            <div class="section-header-text">
                <h1 class="section-title">Welcome to ECL</h1>
                <div class="section-subtitle">Choose a practice mode, or open the dashboard for deeper statistics.</div>
            </div>
            <div class="flex items-center flex-wrap gap-x-4" style="gap:10px;">
                <a asp-controller="ListeningQuestions" asp-action="StartQuiz" class="btn btn-primary">
                    <i class="bi bi-play-fill"></i> Start practice
                </a>
                @if (User?.IsInRole("Admin") == true)
                {
                    <a asp-controller="Home" asp-action="Dashboard" class="btn btn-ghost">
                        <i class="bi bi-graph-up-arrow"></i> Dashboard
                    </a>
                }
            </div>
        </div>

        <div class="stats-cards-grid" role="list" aria-label="Library summary">
            <div class="stat-number-card stat-number-card--violet" role="listitem">
                <span class="stat-number-card__icon" aria-hidden="true"><i class="bi bi-collection-fill"></i></span>
                <div class="stat-number-card__content">
                    <span class="stat-number-card__value">@Model.TotalQuestionsCount</span>
                    <span class="stat-number-card__label">Total questions</span>
                </div>
                <span class="stat-number-card__meta">Library</span>
            </div>
            <div class="stat-number-card stat-number-card--blue" role="listitem">
                <span class="stat-number-card__icon" aria-hidden="true"><i class="bi bi-stack"></i></span>
                <div class="stat-number-card__content">
                    <span class="stat-number-card__value">@totalForms</span>
                    <span class="stat-number-card__label">Available forms</span>
                </div>
                <span class="stat-number-card__meta">Listening<br />Reading</span>
            </div>
            <div class="stat-number-card stat-number-card--emerald" role="listitem">
                <span class="stat-number-card__icon" aria-hidden="true"><i class="bi bi-tags-fill"></i></span>
                <div class="stat-number-card__content">
                    <span class="stat-number-card__value">@totalTopics</span>
                    <span class="stat-number-card__label">Grammar topics</span>
                </div>
                <span class="stat-number-card__meta">Grammar</span>
            </div>
            <div class="stat-number-card stat-number-card--amber" role="listitem">
                <span class="stat-number-card__icon" aria-hidden="true"><i class="bi bi-lightning-charge-fill"></i></span>
                <div class="stat-number-card__content">
                    <span class="stat-number-card__value">@Model.ListeningFormsCount</span>
                    <span class="stat-number-card__label">Listening forms</span>
                </div>
                <span class="stat-number-card__meta">Quick start</span>
            </div>
        </div>
    </section>

    <section class="dash-section" aria-labelledby="nav-heading">
        <header class="dash-section-head">
            <h2 id="nav-heading">Pick a practice mode</h2>
            <p>Each mode takes you directly to the quiz start page.</p>
        </header>

        <div class="practice-mode-grid">
            <a asp-controller="ListeningQuestions" asp-action="StartQuiz" class="practice-mode practice-mode--listen">
                <div class="practice-mode__head">
                    <span class="practice-mode__icon" aria-hidden="true"><i class="bi bi-headphones"></i></span>
                    <div>
                        <div class="practice-mode__title">Listening</div>
                        <div class="practice-mode__sub">
                            @Model.ListeningFormsCount forms<br />
                            @Model.ListeningQuestionsCount questions
                        </div>
                    </div>
                </div>
                <p class="practice-mode__desc">Audio comprehension with exam-style questions and quick feedback.</p>
                <span class="practice-mode__cta">
                    <span>Start</span>
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </span>
            </a>

            <a asp-controller="ReadingQuestions" asp-action="StartQuiz" class="practice-mode practice-mode--read">
                <div class="practice-mode__head">
                    <span class="practice-mode__icon" aria-hidden="true"><i class="bi bi-book-half"></i></span>
                    <div>
                        <div class="practice-mode__title">Reading</div>
                        <div class="practice-mode__sub">
                            @Model.ReadingFormsCount forms<br />
                            @Model.ReadingQuestionsCount questions
                        </div>
                    </div>
                </div>
                <p class="practice-mode__desc">Passages and comprehension sets for detail and inference.</p>
                <span class="practice-mode__cta">
                    <span>Start</span>
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </span>
            </a>

            <a asp-controller="GrammarQuestions" asp-action="StartQuiz" class="practice-mode practice-mode--grammar">
                <div class="practice-mode__head">
                    <span class="practice-mode__icon" aria-hidden="true"><i class="bi bi-spellcheck"></i></span>
                    <div>
                        <div class="practice-mode__title">Grammar</div>
                        <div class="practice-mode__sub">
                            @Model.GrammarTopicsCount topics<br />
                            @Model.GrammarQuestionsCount questions
                        </div>
                    </div>
                </div>
                <p class="practice-mode__desc">Topic drills across levels (Beginner → Advanced) with explanations.</p>
                <span class="practice-mode__cta">
                    <span>Start</span>
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </span>
            </a>
        </div>
    </section>
</div>
