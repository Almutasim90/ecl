@model ECL.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
@if (ViewData["DashboardWarning"] is string msg)
{
    <div class="alert-warning" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @msg
        <a asp-controller="Home" asp-action="DatabaseUnavailable">Details</a>
    </div>
}

<!-- Statistics cards -->
<section class="dashboard-stats-section" aria-label="Overview statistics">
    <h2 class="stats-section-title">Overview</h2>
    <div class="stats-cards-grid">
        <div class="stat-number-card stat-number-card--violet">
            <div class="stat-number-card__icon">
                <i class="bi bi-collection-fill"></i>
            </div>
            <div class="stat-number-card__content">
                <span class="stat-number-card__value">@Model.TotalQuestionsCount</span>
                <span class="stat-number-card__label">Total Questions</span>
            </div>
        </div>
        <a asp-controller="ListeningQuestions" asp-action="Index" class="stat-number-card stat-number-card--blue">
            <div class="stat-number-card__icon">
                <i class="bi bi-headphones"></i>
            </div>
            <div class="stat-number-card__content">
                <span class="stat-number-card__value">@Model.ListeningQuestionsCount</span>
                <span class="stat-number-card__label">Listening Questions</span>
            </div>
            <span class="stat-number-card__meta">@Model.ListeningFormsCount form(s)</span>
        </a>
        <a asp-controller="ReadingQuestions" asp-action="Index" class="stat-number-card stat-number-card--emerald">
            <div class="stat-number-card__icon">
                <i class="bi bi-journal-text"></i>
            </div>
            <div class="stat-number-card__content">
                <span class="stat-number-card__value">@Model.ReadingQuestionsCount</span>
                <span class="stat-number-card__label">Reading Questions</span>
            </div>
            <span class="stat-number-card__meta">@Model.ReadingFormsCount form(s)</span>
        </a>
        <div class="stat-number-card stat-number-card--amber">
            <div class="stat-number-card__icon">
                <i class="bi bi-ui-checks-grid"></i>
            </div>
            <div class="stat-number-card__content">
                <span class="stat-number-card__value">@(Model.ListeningFormsCount + Model.ReadingFormsCount)</span>
                <span class="stat-number-card__label">Quiz Forms</span>
            </div>
        </div>
    </div>
</section>

<!-- Quick-access stat cards -->
<div class="dashboard-stats">
    <a asp-controller="ListeningQuestions" asp-action="Index" class="stat-card">
        <div class="stat-card-icon icon-pill blue">
            <i class="bi bi-headphones"></i>
        </div>
        <div>
            <div class="stat-card-label">Manage</div>
            <div class="stat-card-value">Listening</div>
        </div>
    </a>
    <a asp-controller="ReadingQuestions" asp-action="Index" class="stat-card">
        <div class="stat-card-icon icon-pill green">
            <i class="bi bi-journal-text"></i>
        </div>
        <div>
            <div class="stat-card-label">Manage</div>
            <div class="stat-card-value">Reading</div>
        </div>
    </a>
    <a asp-controller="ListeningQuestions" asp-action="StartQuiz" class="stat-card">
        <div class="stat-card-icon icon-pill purple">
            <i class="bi bi-headphones-simple"></i>
        </div>
        <div>
            <div class="stat-card-label">Practice</div>
            <div class="stat-card-value">Listening Quiz</div>
        </div>
    </a>
    <a asp-controller="ReadingQuestions" asp-action="StartQuiz" class="stat-card">
        <div class="stat-card-icon icon-pill orange">
            <i class="bi bi-book-open"></i>
        </div>
        <div>
            <div class="stat-card-label">Practice</div>
            <div class="stat-card-value">Reading Quiz</div>
        </div>
    </a>
</div>

<!-- Feature cards -->
<div class="dashboard-panels">
    <div class="info-card">
        <div class="info-card-title">
            <span class="icon-pill blue">
                <i class="bi bi-headphones"></i>
            </span>
            Listening Quiz
        </div>
        <div class="info-card-body">
            Test your listening comprehension with audio-based multiple-choice questions.
            Improve your ability to understand spoken English in real exam conditions.
        </div>
        <a asp-controller="ListeningQuestions" asp-action="StartQuiz" class="btn btn-primary">
            <i class="bi bi-play-fill"></i> Start Listening Quiz
        </a>
    </div>
    <div class="info-card">
        <div class="info-card-title">
            <span class="icon-pill green">
                <i class="bi bi-book-open"></i>
            </span>
            Reading Quiz
        </div>
        <div class="info-card-body">
            Strengthen your reading skills with text-based comprehension questions and
            passages to sharpen your analytical thinking.
        </div>
        <a asp-controller="ReadingQuestions" asp-action="StartQuiz" class="btn btn-success">
            <i class="bi bi-play-fill"></i> Start Reading Quiz
        </a>
    </div>
</div>
