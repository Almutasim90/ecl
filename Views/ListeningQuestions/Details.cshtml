@model ECL.Models.ListeningQuestion

@{
    ViewData["Title"] = "Listening Question Details";
}

<div class="form-card">
    <div class="form-card-header">
        <div class="form-card-icon blue"><i class="bi bi-headphones"></i></div>
        <div>
            <div class="form-card-title">Listening Question <span class="text-blue-500">#@Model.Qno</span></div>
            <div class="form-card-subtitle">Form @Model.FormNumber</div>
        </div>
    </div>

    <div class="form-card-body">
        @if (!string.IsNullOrEmpty(Model.AudioFile))
        {
            <div class="mb-5 p-3 rounded-xl bg-blue-50 border border-blue-100">
                <div class="text-xs font-semibold text-blue-400 uppercase mb-2">Audio</div>
                <audio controls class="w-full rounded-lg">
                    <source src="/AUDIO/@Model.AudioFile" type="audio/wav" />
                    Your browser does not support audio.
                </audio>
            </div>
        }

        <div class="detail-row">
            <span class="detail-key">Form #</span>
            <span class="detail-val">@Model.FormNumber</span>
        </div>
        <div class="detail-row">
            <span class="detail-key">Audio File</span>
            <span class="detail-val">@(Model.AudioFile ?? "—")</span>
        </div>
        <div class="detail-row">
            <span class="detail-key">Option A</span>
            <span class="detail-val">@Model.OptionA</span>
        </div>
        <div class="detail-row">
            <span class="detail-key">Option B</span>
            <span class="detail-val">@Model.OptionB</span>
        </div>
        <div class="detail-row">
            <span class="detail-key">Option C</span>
            <span class="detail-val">@Model.OptionC</span>
        </div>
        <div class="detail-row">
            <span class="detail-key">Option D</span>
            <span class="detail-val">@Model.OptionD</span>
        </div>
        <div class="detail-row">
            <span class="detail-key">Correct Answer</span>
            <span class="detail-val">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold" style="background:#eff6ff;color:#2563eb">
                    @(new[]{"A","B","C","D"}[Model.CorrectOption - 1])
                </span>
            </span>
        </div>

        <div class="form-actions mt-5">
            <a asp-action="Edit" asp-route-id="@Model.Qno" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-ghost">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>
</div>
