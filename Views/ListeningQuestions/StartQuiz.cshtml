@model List<int>
@{
    ViewData["Title"] = "Start Quiz";
}

<h1 class="mb-4">Start Quiz</h1>

@if (TempData["DbError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>⚠️ Database Error:</strong> @TempData["DbError"]
        <br/><small>Check that the database is connected and contains data. Contact your administrator if this persists.</small>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-warning text-center">
        No quiz forms available. The database may be empty or unreachable.
    </div>
}

<div class="row row-cols-1 row-cols-md-3 g-4">


    
    @foreach (var num in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-lg hover-shadow">
               
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <h2 class="card-title">Form @num</h2>
                    <a asp-action="Quiz" asp-route-formNumber="@num" class="btn btn-primary mt-3">Start Form @num</a>
                </div>
            </div>
        </div>
    }
</div>
