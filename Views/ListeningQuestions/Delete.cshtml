@model ECL.Models.ListeningQuestion

@{
    ViewData["Title"] = "Delete Listening Question";
}

<div class="form-card">
    <div class="form-card-header">
        <div class="form-card-icon red"><i class="bi bi-trash3"></i></div>
        <div>
            <div class="form-card-title">Delete Question <span class="text-red-500">#@Model.Qno</span></div>
            <div class="form-card-subtitle text-red-400">This action cannot be undone.</div>
        </div>
    </div>

    <div class="form-card-body">
        <div class="alert-warning mb-4">
            Are you sure you want to permanently delete this listening question?
        </div>

        <div class="detail-row">
            <span class="detail-key">Form #</span>
            <span class="detail-val">@Model.FormNumber</span>
        </div>
        <div class="detail-row">
            <span class="detail-key">Audio File</span>
            <span class="detail-val">@(Model.AudioFile ?? "—")</span>
        </div>
        <div class="detail-row">
            <span class="detail-key">Option A</span>
            <span class="detail-val">@Model.OptionA</span>
        </div>
        <div class="detail-row">
            <span class="detail-key">Option B</span>
            <span class="detail-val">@Model.OptionB</span>
        </div>
        <div class="detail-row">
            <span class="detail-key">Option C</span>
            <span class="detail-val">@Model.OptionC</span>
        </div>
        <div class="detail-row">
            <span class="detail-key">Option D</span>
            <span class="detail-val">@Model.OptionD</span>
        </div>
        <div class="detail-row">
            <span class="detail-key">Correct Answer</span>
            <span class="detail-val">Option @Model.CorrectOption</span>
        </div>

        <form asp-action="Delete" class="form-actions mt-5">
            <input type="hidden" asp-for="Qno" />
            <button type="submit" class="btn-danger">
                <i class="bi bi-trash3"></i> Yes, Delete
            </button>
            <a asp-action="Index" class="btn-ghost">
                <i class="bi bi-arrow-left"></i> Cancel
            </a>
        </form>
    </div>
</div>
