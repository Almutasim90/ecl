@{
    ViewData["Title"] = "Listening Questions";
}

<div class="section-header">
    <div class="section-header-text">
        <h1 class="section-title">Listening Questions</h1>
        <p class="section-subtitle">Browse and manage all audio-based questions.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Create New
    </a>
</div>

<div class="table-card">
    <table id="ListeningTable" class="display hover stripe w-full">
        <thead>
            <tr>
                <th>Q#</th>
                <th>Form</th>
                <th>Audio</th>
                <th>Option A</th>
                <th>Option B</th>
                <th>Option C</th>
                <th>Option D</th>
                <th>Correct</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

@section Scripts {
    <script>
    $(function () {
        $('#ListeningTable').DataTable({
            serverSide:  true,
            processing:  true,
            responsive:  true,
            pageLength:  10,
            ajax: {
                url:  '@Url.Action("LoadData", "ListeningQuestions")',
                type: 'GET',
                data: function (d) {
                    return {
                        draw:        d.draw,
                        start:       d.start,
                        length:      d.length,
                        search:      d.search.value,
                        orderColumn: d.columns[d.order[0].column].data,
                        orderDir:    d.order[0].dir
                    };
                },
                error: function (xhr, error, thrown) {
                    console.error('DataTable AJAX error', xhr.status, thrown);
                }
            },
            columns: [
                { data: 'qno',           title: 'Q#',       width: '55px'  },
                { data: 'formNumber',    title: 'Form',     width: '65px'  },
                {
                    data:       'audioFile',
                    title:      'Audio',
                    orderable:  false,
                    searchable: false,
                    render: function (file) {
                        if (!file) return '<span class="text-gray-300">—</span>';
                        return '<audio controls style="width:160px">' +
                               '<source src="/AUDIO/' + file + '" type="audio/wav">' +
                               'Not supported</audio>';
                    }
                },
                { data: 'optionA',       title: 'Option A' },
                { data: 'optionB',       title: 'Option B' },
                { data: 'optionC',       title: 'Option C' },
                { data: 'optionD',       title: 'Option D' },
                {
                    data: 'correctOption', title: 'Correct', width: '75px',
                    render: function (v) {
                        var labels = ['A','B','C','D'];
                        var l = labels[v-1] || v;
                        return '<span style="display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;background:#eff6ff;color:#2563eb;font-size:0.75rem;font-weight:700">' + l + '</span>';
                    }
                },
                {
                    data:       'qno',
                    title:      'Actions',
                    orderable:  false,
                    searchable: false,
                    width:      '100px',
                    render: function (id) {
                        return '<div style="display:flex;gap:5px">' +
                               '<a class="dt-btn dt-btn-view" href="/ListeningQuestions/Details/' + id + '" title="View"><span class="material-icons" style="font-size:15px">visibility</span></a>' +
                               '<a class="dt-btn dt-btn-edit"  href="/ListeningQuestions/Edit/'    + id + '" title="Edit"><span class="material-icons" style="font-size:15px">edit</span></a>' +
                               '<a class="dt-btn dt-btn-delete" href="/ListeningQuestions/Delete/' + id + '" title="Delete"><span class="material-icons" style="font-size:15px">delete</span></a>' +
                               '</div>';
                    }
                }
            ],
            order:      [[0, 'asc']],
            lengthMenu: [[10, 25, 50, 100, -1], ['10', '25', '50', '100', 'All']],
            language: {
                processing: '<span class="material-icons spin">autorenew</span> Loading…',
                paginate: {
                    previous: '<span class="material-icons">chevron_left</span>',
                    next:     '<span class="material-icons">chevron_right</span>'
                },
                info:    'Showing _START_–_END_ of _TOTAL_ questions',
                search:  '<span class="material-icons align-middle" style="font-size:18px">search</span>'
            }
        });
    });
    </script>
}
