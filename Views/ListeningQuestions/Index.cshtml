@{
    ViewData["Title"] = "Listening Questions";
}

<h1>Listening Questions</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">
        <span class="material-icons align-middle" style="font-size:18px">add</span> Create New
    </a>
</p>

<div class="table-responsive">
    <table id="ListeningTable" class="display material hover stripe" style="width:100%">
        <thead>
            <tr>
                <th>Q#</th>
                <th>Form</th>
                <th>Audio</th>
                <th>Option A</th>
                <th>Option B</th>
                <th>Option C</th>
                <th>Option D</th>
                <th>Correct</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

@section Scripts {
    <script>
    $(function () {
        $('#ListeningTable').DataTable({
            serverSide:  true,
            processing:  true,
            responsive:  true,
            pageLength:  10,
            ajax: {
                url:  '@Url.Action("LoadData", "ListeningQuestions")',
                type: 'GET',
                data: function (d) {
                    return {
                        draw:        d.draw,
                        start:       d.start,
                        length:      d.length,
                        search:      d.search.value,
                        orderColumn: d.columns[d.order[0].column].data,
                        orderDir:    d.order[0].dir
                    };
                },
                error: function (xhr, error, thrown) {
                    console.error('DataTable AJAX error', xhr.status, thrown);
                }
            },
            columns: [
                { data: 'qno',           title: 'Q#',       width: '55px'  },
                { data: 'formNumber',    title: 'Form',     width: '65px'  },
                {
                    data:       'audioFile',
                    title:      'Audio',
                    orderable:  false,
                    searchable: false,
                    render: function (file) {
                        if (!file) return '—';
                        return '<audio controls style="width:160px">' +
                               '<source src="/AUDIO/' + file + '" type="audio/wav">' +
                               'Not supported</audio>';
                    }
                },
                { data: 'optionA',       title: 'Option A' },
                { data: 'optionB',       title: 'Option B' },
                { data: 'optionC',       title: 'Option C' },
                { data: 'optionD',       title: 'Option D' },
                { data: 'correctOption', title: 'Correct',  width: '75px'  },
                {
                    data:       'qno',
                    title:      'Actions',
                    orderable:  false,
                    searchable: false,
                    width:      '160px',
                    render: function (id) {
                        return '<a class="btn btn-sm btn-outline-primary me-1"   href="/ListeningQuestions/Details/' + id + '" title="View"><span class="material-icons" style="font-size:16px">visibility</span></a>' +
                               '<a class="btn btn-sm btn-outline-secondary me-1" href="/ListeningQuestions/Edit/'    + id + '" title="Edit"><span class="material-icons" style="font-size:16px">edit</span></a>' +
                               '<a class="btn btn-sm btn-outline-danger"          href="/ListeningQuestions/Delete/'  + id + '" title="Delete"><span class="material-icons" style="font-size:16px">delete</span></a>';
                    }
                }
            ],
            order:      [[0, 'asc']],
            lengthMenu: [[10, 25, 50, 100, -1], ['10', '25', '50', '100', 'All']],
            language: {
                processing: '<span class="material-icons spin">autorenew</span> Loading…',
                paginate: {
                    previous: '<span class="material-icons">chevron_left</span>',
                    next:     '<span class="material-icons">chevron_right</span>'
                },
                info:    'Showing _START_–_END_ of _TOTAL_ questions',
                search:  '<span class="material-icons align-middle" style="font-size:18px">search</span>'
            }
        });
    });
    </script>
}
