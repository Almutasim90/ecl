@{
    ViewData["Title"] = "Grammar Questions";
}

<div class="section-header">
    <div class="section-header-text">
        <h1 class="section-title">Grammar Questions</h1>
        <p class="section-subtitle">Browse and manage all English grammar questions.</p>
    </div>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-lg"></i> Create New
    </a>
</div>

<div class="grammar-toolbar">
    <div class="toolbar-search">
        <span class="material-icons">search</span>
        <input type="text" id="grammarSearch" placeholder="Search questions..." class="toolbar-search-input">
    </div>
    <div class="toolbar-filters">
        <select id="grammarTypeFilter" class="toolbar-select">
            <option value="">All Types</option>
            <option value="Present Simple">Present Simple</option>
            <option value="Past Simple">Past Simple</option>
            <option value="Present Continuous">Present Continuous</option>
            <option value="Past Continuous">Past Continuous</option>
            <option value="Present Perfect">Present Perfect</option>
            <option value="Past Perfect">Past Perfect</option>
            <option value="Future Simple">Future Simple</option>
            <option value="Modals">Modals</option>
            <option value="Passive Voice">Passive Voice</option>
            <option value="Conditionals">Conditionals</option>
            <option value="Relative Clauses">Relative Clauses</option>
            <option value="Reported Speech">Reported Speech</option>
            <option value="Prepositions">Prepositions</option>
            <option value="Articles">Articles</option>
            <option value="Conjunctions">Conjunctions</option>
        </select>
    </div>
</div>

<div class="table-card">
    <table id="GrammarTable" class="display hover stripe w-full">
        <thead>
            <tr>
                <th>Q#</th>
                <th>Type</th>
                <th>Question</th>
                <th>Option A</th>
                <th>Option B</th>
                <th>Option C</th>
                <th>Option D</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

@section Scripts {
    <script>
    $(function () {
        var grammarTable = $('#GrammarTable').DataTable({
            serverSide:  true,
            processing:  true,
            responsive:  true,
            pageLength:  10,
            ajax: {
                url:  '@Url.Action("LoadData", "GrammarQuestions")',
                type: 'GET',
                data: function (d) {
                    d.search = $('#grammarSearch').val();
                    d.typeFilter = $('#grammarTypeFilter').val();
                    return d;
                },
                error: function (xhr, error, thrown) {
                    console.error('DataTable AJAX error', xhr.status, thrown);
                }
            },
            columns: [
                { data: 'qno',         title: 'Q#',       width: '55px'  },
                { data: 'grammarType', title: 'Type',     width: '160px' },
                { data: 'questionText',title: 'Question'                 },
                { data: 'optionA',     title: 'Option A'                 },
                { data: 'optionB',     title: 'Option B'                 },
                { data: 'optionC',     title: 'Option C'                 },
                { data: 'optionD',     title: 'Option D'                 },
                {
                    data:       'qno',
                    title:      'Actions',
                    orderable:  false,
                    searchable: false,
                    width:      '100px',
                    render: function (id) {
                        return '<div style="display:flex;gap:5px">' +
                               '<a class="dt-btn dt-btn-view" href="/GrammarQuestions/Details/' + id + '" title="View"><span class="material-icons" style="font-size:15px">visibility</span></a>' +
                               '<a class="dt-btn dt-btn-edit"  href="/GrammarQuestions/Edit/'    + id + '" title="Edit"><span class="material-icons" style="font-size:15px">edit</span></a>' +
                               '<a class="dt-btn dt-btn-delete" href="/GrammarQuestions/Delete/' + id + '" title="Delete"><span class="material-icons" style="font-size:15px">delete</span></a>' +
                               '</div>';
                    }
                }
            ],
            order:      [[0, 'asc']],
            lengthMenu: [[10, 25, 50, 100, -1], ['10', '25', '50', '100', 'All']],
            language: {
                processing: '<span class="material-icons spin">autorenew</span> Loading…',
                paginate: {
                    previous: '<span class="material-icons">chevron_left</span>',
                    next:     '<span class="material-icons">chevron_right</span>'
                },
                info:    'Showing _START_–_END_ of _TOTAL_ questions',
                search:  '',
                searchPlaceholder: ''
            }
        });

        var searchTimeout;
        $('#grammarSearch').on('keyup', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(function() {
                grammarTable.draw();
            }, 300);
        });

        $('#grammarTypeFilter').on('change', function() {
            grammarTable.draw();
        });
    });
    </script>
}

